# --- Core ---
DEBUG=false
API_PREFIX=/api

# --- Database ---
DATABASE_URL=postgresql+psycopg2://aibot:aibot@localhost:5432/aibot
# For a no-Docker local run you can use SQLite instead:
# DATABASE_URL=sqlite:///./aibot.db

# --- Celery / broker (RabbitMQ) + result backend (Redis) ---
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Redis (dedup / filter cache) ---
REDIS_URL=redis://localhost:6379/1

# --- Scheduling ---
PARSE_INTERVAL_MINUTES=30

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# --- Telegram / Telethon ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=aibot
TELEGRAM_TARGET_CHANNEL=@your_channel

# --- Filtering ---
# JSON array
FILTER_LANGUAGES=["ru","en"]
# any | all
KEYWORD_MATCH_MODE=any
